# Copy to .env and adjust. Never commit the result.

# Nodes to monitor: comma-separated user@host[:port]. A Spark answers to its
# own hostname with .local appended, so an address is rarely needed — run
# ./scripts/setup.sh with no arguments to find them automatically.
SPARKTOP_NODES=ubuntu@spark-a1b2.local,ubuntu@spark-c3d4.local

# Private key used to reach those nodes (path inside the container).
SPARKTOP_SSH_KEY=/config/id_ed25519

# Required only if you store SSH passwords instead of using keys.
# Generate with: openssl rand -hex 32
SPARKTOP_SECRET=

# Optional. When set, the API and WebSocket require this bearer token.
SPARKTOP_TOKEN=

# Host port for the dashboard.
SPARKTOP_PORT=5757

# Poll intervals in milliseconds.
SPARKTOP_FAST_MS=1000
SPARKTOP_SLOW_MS=10000
